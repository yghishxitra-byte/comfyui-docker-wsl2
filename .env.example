# ─── Порты ───────────────────────────────────────────────
COMFYUI_PORT=3000

# ─── Параметры GPU ───────────────────────────────────────
# --highvram       : держать модель целиком в VRAM (для 3060/12GB)
# --reserve-vram 0.5: оставить 0.5GB VRAM системе, чтобы не было фризов
# --fp16-vae       : VAE в fp16 (меньше VRAM, для SDXL критично)
COMFYUI_ARGS=--highvram --reserve-vram 0.5 --fp16-vae

# ─── Веб-доступ ──────────────────────────────────────────
WEB_ENABLE_AUTH=false

# ─── Модель (для справки) ────────────────────────────────
MODEL_NAME=sfV6XL_v6.safetensors